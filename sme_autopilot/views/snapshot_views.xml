<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sme_autopilot_snapshot_list" model="ir.ui.view">
        <field name="name">sme.autopilot.snapshot.list</field>
        <field name="model">sme.autopilot.snapshot</field>
        <field name="arch" type="xml">

            <list string="Business Health Snapshots">
                <field name="generated_at"/>
                <field name="current_cash"/>
                <field name="overdue_receivables"/>
                <field name="supplier_payments_due"/>
                <field name="stalled_quotation_value"/>
                <field name="projected_cash"/>

                <field
                    name="risk_level"
                    widget="badge"
                    decoration-success="risk_level == 'low'"
                    decoration-info="risk_level == 'medium'"
                    decoration-warning="risk_level == 'high'"
                    decoration-danger="risk_level == 'critical'"
                />

                <field
                    name="approval_status"
                    widget="badge"
                    decoration-warning="approval_status == 'pending'"
                    decoration-success="approval_status == 'approved'"
                    decoration-danger="approval_status == 'rejected'"
                />
            </list>

        </field>
    </record>

    <record id="view_sme_autopilot_snapshot_form" model="ir.ui.view">
        <field name="name">sme.autopilot.snapshot.form</field>
        <field name="model">sme.autopilot.snapshot</field>
        <field name="arch" type="xml">

            <form string="SME Autopilot">

                <header>

                    <button
                        name="action_analyse_business"
                        string="Analyse Business"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        name="action_approve_recommendation"
                        string="Approve &amp; Create Follow-Ups"
                        type="object"
                        class="btn-primary"
                        invisible="approval_status != 'pending'"
                    />

                    <button
                        name="action_reject_recommendation"
                        string="Reject Recommendation"
                        type="object"
                        invisible="approval_status != 'pending'"
                    />

                    <field
                        name="approval_status"
                        widget="statusbar"
                        statusbar_visible="pending,approved,rejected"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <div class="text-muted">
                            AI Cash-Flow Copilot for SMEs
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="generated_at" readonly="1"/>
                        </group>

                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="risk_level != 'critical'"
                    >
                        <strong>Critical Cash-Flow Risk Detected</strong>
                        <br/>
                        Projected cash is negative. Review the AI analysis
                        and recommended follow-up actions below.
                    </div>

                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="risk_level != 'high'"
                    >
                        <strong>High Cash-Flow Risk</strong>
                        <br/>
                        Cash reserves are approaching a high-risk level.
                    </div>

                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="risk_level != 'medium'"
                    >
                        <strong>Cash-Flow Watch</strong>
                        <br/>
                        Monitor upcoming receipts and obligations.
                    </div>

                    <div
                        class="alert alert-success"
                        role="alert"
                        invisible="risk_level != 'low'"
                    >
                        <strong>Cash Position Stable</strong>
                        <br/>
                        Current projected cash remains above the
                        configured risk thresholds.
                    </div>

                    <separator string="Cash-Flow Position"/>

                    <group>

                        <group string="Liquidity">

                            <field name="current_cash"/>

                            <field name="expected_receipts"/>

                            <field
                                name="projected_cash"
                                readonly="1"
                            />

                            <field
                                name="risk_level"
                                widget="badge"
                                readonly="1"
                                decoration-success="risk_level == 'low'"
                                decoration-info="risk_level == 'medium'"
                                decoration-warning="risk_level == 'high'"
                                decoration-danger="risk_level == 'critical'"
                            />

                        </group>

                        <group string="Cash-Flow Drivers">

                            <field
                                name="overdue_receivables"
                                readonly="1"
                            />

                            <field
                                name="supplier_payments_due"
                                readonly="1"
                            />

                            <field name="other_commitments"/>

                            <field
                                name="stalled_quotation_value"
                                readonly="1"
                            />

                        </group>

                    </group>

                    <separator string="AI Cash-Flow Copilot"/>

                    <div
                        class="alert alert-light border"
                        role="alert"
                    >
                        Gemini analyses the current Odoo business data
                        and provides recommendations. No business action
                        is executed without explicit human approval.
                    </div>

                    <group>

                        <field
                            name="ai_explanation"
                            readonly="1"
                        />

                        <field
                            name="ai_recommendation"
                            readonly="1"
                        />

                        <field
                            name="ai_expected_impact"
                            readonly="1"
                        />

                    </group>

                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="approval_status != 'pending'"
                    >
                        <strong>Human Approval Required</strong>
                        <br/>
                        Review the AI recommendation before creating
                        any Odoo follow-up activities.
                    </div>

                    <div
                        class="alert alert-success"
                        role="alert"
                        invisible="approval_status != 'approved'"
                    >
                        <strong>Human-Approved Actions Executed</strong>
                        <br/>
                        SME Autopilot has processed the approved
                        Odoo follow-up actions.
                    </div>

                    <separator
                        string="Action Execution"
                        invisible="approval_status != 'approved'"
                    />

                    <group
                        invisible="approval_status != 'approved'"
                    >

                        <group>

                            <field
                                name="executed_at"
                                readonly="1"
                            />

                            <field
                                name="execution_overdue_followups"
                                readonly="1"
                            />

                            <field
                                name="execution_stalled_followups"
                                readonly="1"
                            />

                        </group>

                        <group>

                            <field
                                name="execution_result"
                                readonly="1"
                            />

                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

</odoo>