<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sme_autopilot_snapshot_list" model="ir.ui.view">
        <field name="name">sme.autopilot.snapshot.list</field>
        <field name="model">sme.autopilot.snapshot</field>
        <field name="arch" type="xml">
            <list string="Business Health Snapshots">
                <field name="generated_at"/>
                <field name="current_cash"/>
                <field name="overdue_receivables"/>
                <field name="supplier_payments_due"/>
                <field name="stalled_quotation_value"/>
                <field name="projected_cash"/>
                <field name="risk_level"/>
                <field name="approval_status"/>
            </list>
        </field>
    </record>

    <record id="view_sme_autopilot_snapshot_form" model="ir.ui.view">
        <field name="name">sme.autopilot.snapshot.form</field>
        <field name="model">sme.autopilot.snapshot</field>
        <field name="arch" type="xml">
            <form string="Business Health Snapshot">

                <header>
                    <button
                        name="action_analyse_business"
                        string="Analyse Business"
                        type="object"
                        class="btn-primary"
                    />
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="generated_at"/>
                        <field name="company_id"/>
                    </group>

                    <group string="Cash-Flow Position">
                        <field name="current_cash"/>
                        <field name="overdue_receivables" readonly="1"/>
                        <field name="expected_receipts"/>
                        <field name="supplier_payments_due" readonly="1"/>
                        <field name="other_commitments"/>
                        <field name="stalled_quotation_value" readonly="1"/>
                        <field name="projected_cash" readonly="1"/>
                        <field name="risk_level" readonly="1"/>
                    </group>

                    <group string="AI Cash-Flow Copilot">
                        <field name="ai_explanation" placeholder="Why is this happening?"/>
                        <field name="ai_recommendation" placeholder="What should the business do next?"/>
                        <field name="ai_expected_impact" placeholder="What is the expected impact?"/>
                        <field name="approval_status"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

</odoo>